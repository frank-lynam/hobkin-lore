{"id": "pick-field", "title": "A field from each object", "code": ".[] | .name", "input": "[{\"name\":\"ada\"},{\"name\":\"bob\"}]", "expect": "\"ada\"\n\"bob\"", "symbols": []}
{"id": "map-select", "title": "Keep some elements", "code": "map(select(.age > 30))", "input": "[{\"age\":25},{\"age\":40}]", "expect": "[{\"age\":40}]", "symbols": ["map", "select"]}
{"id": "sum", "title": "Sum with reduce", "code": "reduce .[] as $n (0; . + $n)", "input": "[1,2,3,4]", "expect": "10", "symbols": ["reduce"]}
{"id": "add", "title": "Sum with add", "code": "add", "input": "[1,2,3,4]", "expect": "10", "symbols": ["add"]}
{"id": "group-count", "title": "Count per group", "code": "group_by(.t) | map({t: .[0].t, n: length})", "input": "[{\"t\":\"a\"},{\"t\":\"b\"},{\"t\":\"a\"}]", "expect": "[{\"t\":\"a\",\"n\":2},{\"t\":\"b\",\"n\":1}]", "symbols": ["group_by", "map", "length"]}
{"id": "default", "title": "A default for a missing field", "code": ".nick // \"anonymous\"", "input": "{\"name\":\"ada\"}", "expect": "\"anonymous\"", "symbols": ["//"]}
{"id": "update", "title": "Update in place", "code": ".count |= . + 1", "input": "{\"count\":1}", "expect": "{\"count\":2}", "symbols": ["|="]}
{"id": "rename-keys", "title": "Rename keys with with_entries", "code": "with_entries(.key |= ascii_upcase)", "input": "{\"a\":1,\"b\":2}", "expect": "{\"A\":1,\"B\":2}", "symbols": ["with_entries"]}
{"id": "csv", "title": "Rows as CSV", "code": ".[] | [.name, .age] | @csv", "input": "[{\"name\":\"ada\",\"age\":36}]", "expect": "\"\\\"ada\\\",36\"", "symbols": ["@csv"]}
{"id": "split-join", "title": "Split and join", "code": "split(\",\") | map(tonumber) | add", "input": " \"1,2,3\" ", "expect": "6", "symbols": ["split", "tonumber", "add"]}
{"id": "try", "title": "Skip what fails", "code": "map(try tonumber catch -1)", "input": "[\"1\",\"x\"]", "expect": "[1,-1]", "symbols": ["try", "tonumber"]}
{"id": "sub", "title": "Replace with a regex", "code": "sub(\"(?<y>\\\\d{4})-(?<m>\\\\d{2})\"; \"\\(.m)/\\(.y)\")", "input": "\"2026-03\"", "expect": "\"03/2026\"", "symbols": ["sub"]}
